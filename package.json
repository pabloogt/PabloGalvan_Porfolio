{
  "name": "portfolio-pablo-galvan",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio técnico de Pablo Galván Tejada: ciberseguridad, sistemas, redes y desarrollo.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:links": "node scripts/check-links.mjs",
    "test:secrets": "node scripts/check-secrets.mjs",
    "verify": "npm run build && npm test && npm run test:links && npm run test:secrets"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.5",
    "astro": "^7.4.12",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  }
}
