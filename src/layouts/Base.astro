---
import '@fontsource-variable/bricolage-grotesque/wght.css';
import '@fontsource-variable/instrument-sans/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { perfil } from '@/data/perfil';

interface Props {
  title: string;
  description: string;
  /** Tipo Open Graph: website para páginas, article para fichas. */
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** Imagen para compartir (ruta absoluta dentro del sitio). */
  ogImage?: string;
}

const { title, description, ogType = 'website', noindex = false, ogImage = '/og.png' } = Astro.props;
const ogUrl = new URL(ogImage, Astro.site);
const fullTitle = title === perfil.nombre ? `${perfil.nombre} · Portfolio técnico` : `${title} · ${perfil.nombreCorto}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: perfil.nombre,
  jobTitle: perfil.titular,
  url: Astro.site?.toString(),
  sameAs: [perfil.github, perfil.linkedin],
  address: { '@type': 'PostalAddress', addressLocality: 'Madrid', addressCountry: 'ES' },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content={perfil.nombre} />
    <meta name="theme-color" content="#f4eee3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161310" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={`${perfil.nombre} · Portfolio técnico`} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -3rem;
    z-index: 100;
    padding: 0.5rem 1rem;
    background: var(--surface);
    border: 2px solid var(--focus);
    border-radius: var(--radius);
  }
  .skip-link:focus { top: 1rem; }
  .skip-link { font-family: var(--font-mono); font-size: var(--fs-sm); }
  main { min-height: 70vh; outline: none; }
</style>
