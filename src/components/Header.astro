---
import Logo from './Logo.astro';
import { perfil } from '@/data/perfil';

const enlaces = [
  { href: '/proyectos/', texto: 'Proyectos', activo: ['/proyectos/'] },
  { href: '/ciberseguridad/', texto: 'Laboratorios', activo: ['/ciberseguridad/'] },
  { href: '/experiencia/', texto: 'Experiencia', activo: ['/experiencia/'] },
  { href: '/sobre-mi/', texto: 'Sobre mí', activo: ['/sobre-mi/', '/formacion/', '/competencias/', '/documentacion/'] },
];
const ruta = Astro.url.pathname;
const esActivo = (prefijos: string[]) => prefijos.some((p) => ruta.startsWith(p));
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label={`${perfil.nombre}, inicio`}>
      <Logo />
      <span class="name">{perfil.nombreCorto}</span>
    </a>

    <details class="menu">
      <summary><span class="visually-hidden">Abrir o cerrar el </span>Menú</summary>
      <nav aria-label="Principal">
        <ul>
          {
            enlaces.map((e) => (
              <li>
                <a href={e.href} aria-current={esActivo(e.activo) ? 'page' : undefined}>{e.texto}</a>
              </li>
            ))
          }
          <li><a class="cta" href="/contacto/" aria-current={ruta.startsWith('/contacto/') ? 'page' : undefined}>Contacto</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); min-height: 4.25rem; }
  .brand {
    display: flex; align-items: center; gap: var(--space-2);
    text-decoration: none; color: var(--text);
    font-family: var(--font-display); font-weight: 650; font-size: 1.1rem; letter-spacing: -0.02em;
  }
  ul { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: var(--space-1); }
  li { margin: 0; }
  nav a {
    position: relative;
    display: block;
    padding: 0.5rem 0.8rem;
    text-decoration: none;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.84rem;
    transition: color 0.18s var(--ease);
  }
  nav a:hover { color: var(--text); }
  nav a:not(.cta)::after {
    content: '';
    position: absolute; left: 0.8rem; right: 0.8rem; bottom: 0.25rem;
    height: 2px; background: var(--accent);
    transform: scaleX(0); transform-origin: left;
    transition: transform 0.22s var(--ease);
  }
  nav a:not(.cta):hover::after, nav a[aria-current='page']:not(.cta)::after { transform: scaleX(1); }
  nav a[aria-current='page'] { color: var(--text); }
  nav a.cta {
    margin-left: var(--space-2);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    color: var(--text);
    padding: 0.45rem 0.9rem;
    transition: background-color 0.18s var(--ease), color 0.18s var(--ease);
  }
  nav a.cta:hover, nav a.cta[aria-current='page'] { background: var(--text); color: var(--bg); }

  /* Escritorio: el <details> se comporta como una barra siempre abierta */
  summary { display: none; }
  .menu > nav { display: block; }

  @media (max-width: 52rem) {
    summary {
      display: inline-flex;
      list-style: none;
      cursor: pointer;
      padding: 0.5rem 0.9rem;
      border: 1px solid var(--border-strong);
      border-radius: var(--radius);
      font-family: var(--font-mono);
      font-size: var(--fs-sm);
    }
    summary::-webkit-details-marker { display: none; }
    .menu[open] summary { background: var(--text); color: var(--bg); }
    .menu:not([open]) > nav { display: none; }
    .menu[open] > nav {
      position: absolute;
      left: 0; right: 0; top: 100%;
      background: var(--bg);
      border-bottom: 1px solid var(--border-strong);
      padding: var(--space-2) 1.25rem var(--space-6);
    }
    ul { flex-direction: column; align-items: stretch; }
    nav a { padding: 0.9rem 0; font-size: 1rem; border-bottom: 1px solid var(--border); }
    nav a:not(.cta)::after { display: none; }
    nav a.cta { margin: var(--space-4) 0 0; text-align: center; padding: 0.8rem; }
  }
</style>

<script>
  // En escritorio el menú debe estar siempre abierto; en móvil, cerrado por defecto.
  const menu = document.querySelector<HTMLDetailsElement>('.menu');
  const mq = window.matchMedia('(min-width: 52.0625rem)');
  const sync = () => {
    if (menu) menu.open = mq.matches;
  };
  sync();
  mq.addEventListener('change', sync);
  // Escape cierra el menú en móvil.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !mq.matches) menu.open = false;
  });
</script>
