---
import EstadoBadge from './EstadoBadge.astro';
import { TIPOS } from '@/data/taxonomia';
import { urlProyecto, type Proyecto } from '@/lib/proyectos';

interface Props {
  proyecto: Proyecto;
  headingLevel?: 'h2' | 'h3';
}
const { proyecto, headingLevel = 'h3' } = Astro.props;
const { data } = proyecto;
const Heading = headingLevel;
const herramientas = data.herramientas.slice(0, 5);
---

<article class="project-card">
  <div class="meta">
    <span class="type">{TIPOS[data.tipo]}</span>
    <EstadoBadge estado={data.estado} />
  </div>
  <Heading class="title">
    <a href={urlProyecto(proyecto)}>{data.titulo}</a>
  </Heading>
  <p class="summary">{data.resumen}</p>
  {
    herramientas.length > 0 && (
      <ul class="tags" aria-label="Herramientas utilizadas">
        {herramientas.map((h) => (
          <li><span class="tag">{h}</span></li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-6);
    transition: border-color 0.15s;
  }
  .project-card:hover { border-color: var(--accent); }
  .meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-2); }
  .type { font-size: var(--fs-sm); color: var(--text-muted); }
  .title { font-size: 1.15rem; margin: 0; }
  .title a { color: var(--text); text-decoration: none; }
  /* Toda la tarjeta es clicable sin anidar enlaces */
  .title a::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius); }
  .title a:focus-visible { outline: none; }
  .project-card:has(a:focus-visible) { outline: 3px solid var(--focus); outline-offset: 2px; }
  .summary { color: var(--text-muted); margin: 0; flex: 1; }
</style>
