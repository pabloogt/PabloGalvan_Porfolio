---
import ProjectCard from './ProjectCard.astro';
import { agruparPorCategoria, type Proyecto } from '@/lib/proyectos';

interface Props {
  proyectos: Proyecto[];
}
const grupos = agruparPorCategoria(Astro.props.proyectos);
const slug = (s: string) => `cat-${s}`;
---

{
  grupos.length > 1 && (
    <nav class="cats" aria-label="Categorías">
      <ul>
        {grupos.map((g) => (
          <li><a href={`#${slug(g.categoria)}`}>{g.titulo} <span class="muted">({g.proyectos.length})</span></a></li>
        ))}
      </ul>
    </nav>
  )
}

{
  grupos.map((g) => (
    <section class="cat" id={slug(g.categoria)} aria-labelledby={`${slug(g.categoria)}-t`}>
      <h2 id={`${slug(g.categoria)}-t`}>{g.titulo}</h2>
      <div class="grid grid-cards">
        {g.proyectos.map((p) => <ProjectCard proyecto={p} />)}
      </div>
    </section>
  ))
}

<style>
  .cats ul { list-style: none; padding: 0; margin: 0 0 var(--space-8); display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .cats li { margin: 0; }
  .cats a {
    display: inline-block; padding: 0.35rem 0.75rem; border: 1px solid var(--border); border-radius: 999px;
    background: var(--surface); text-decoration: none; color: var(--text); font-size: var(--fs-sm);
  }
  .cats a:hover { border-color: var(--accent); }
  .cat { padding-bottom: var(--space-8); }
  .cat h2 { margin-top: var(--space-8); }
</style>
