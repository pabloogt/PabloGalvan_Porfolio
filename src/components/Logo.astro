---
/** Monograma PG: la P en tinta y la G en el color de acento. Hereda el color del texto. */
interface Props {
  size?: number;
}
const { size = 34 } = Astro.props;
---

<svg class="logo" width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <g fill="none" stroke-width="6.5" stroke-linecap="square">
    <path class="p" d="M13 46V19h8a8 8 0 0 1 0 16h-8"></path>
    <path class="g" d="M50.5 24.5A12 12 0 1 0 53 32.5H42.5"></path>
  </g>
</svg>

<style>
  .logo { flex: none; }
  .p { stroke: currentColor; }
  .g { stroke: var(--accent); }
</style>
