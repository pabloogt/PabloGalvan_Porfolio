---
import { Image } from 'astro:assets';
import { CATEGORIAS, TIPOS } from '@/data/taxonomia';
import { urlProyecto, type Proyecto } from '@/lib/proyectos';
import { iniciales, lista, medioTarjeta, nombreCorto } from '@/lib/tarjeta';

interface Props {
  proyecto: Proyecto;
  /** "wide": imagen al lado del texto, ocupa todo el ancho. "tall": imagen encima. */
  variante?: 'wide' | 'tall';
  indice?: string;
  headingLevel?: 'h2' | 'h3';
  /** La primera tarjeta de la página carga su imagen sin diferir. */
  prioridad?: boolean;
}
const { proyecto, variante = 'tall', indice, headingLevel = 'h3', prioridad = false } = Astro.props;
const d = proyecto.data;
const Heading = headingLevel;
const url = urlProyecto(proyecto);

// Los campos opcionales se normalizan aquí: la tarjeta debe poder pintarse con cualquier combinación de datos.
const cifras = lista(d.cifras);
const herramientas = lista(d.herramientas);
const medio = medioTarjeta({ portada: d.portada, cifras });
---

<article class:list={['feature', variante]}>
  <a class="media" href={url} tabindex="-1" aria-hidden="true">
    {
      medio === 'portada' && d.portada && (
        <Image
          src={d.portada}
          alt=""
          widths={[480, 800, 1200]}
          sizes="(max-width: 52rem) 100vw, 38rem"
          format="webp"
          loading={prioridad ? 'eager' : 'lazy'}
        />
      )
    }
    {
      medio === 'cifras' && (
        <div class="figures dotgrid">
          {cifras.map((c) => (
            <div class="figure">
              <span class="value">{c.valor}</span>
              <span class="what">{c.etiqueta}</span>
            </div>
          ))}
        </div>
      )
    }
    {
      medio === 'emblema' && (
        <div class="emblem dotgrid">
          <span class="mark tl" /><span class="mark tr" /><span class="mark bl" /><span class="mark br" />
          <span class="initials">{iniciales(d.titulo)}</span>
          <span class="what">{nombreCorto(d.titulo)} · {CATEGORIAS[d.categoria] ?? ''}</span>
        </div>
      )
    }
  </a>

  <div class="body">
    <p class="label">
      {indice && <span class="idx">{indice}</span>}
      {TIPOS[d.tipo]}{d.fecha && ` · ${d.fecha}`}
    </p>
    <Heading class="title"><a href={url}>{d.titulo}</a></Heading>
    <p class="summary">{d.resumen}</p>
    {d.rol && <p class="rol"><span class="label">Mi papel</span>{d.rol}</p>}
    {
      herramientas.length > 0 && (
        <ul class="tags" aria-label="Tecnologías">
          {herramientas.slice(0, 6).map((h) => <li><span class="tag">{h}</span></li>)}
        </ul>
      )
    }
    <p class="links">
      <a class="link-arrow" href={url}>Ver ficha<span class="visually-hidden"> de {d.titulo}</span></a>
      {d.web && <a class="link-arrow ext" href={d.web} rel="noopener">Visitar la web</a>}
      {d.repo && <a class="link-arrow ext" href={d.repo} rel="noopener">GitHub</a>}
    </p>
  </div>
</article>

<style>
  .feature { display: grid; gap: var(--space-6); align-content: start; }
  .feature.wide { gap: var(--space-8); }
  @media (min-width: 56rem) {
    .feature.wide { grid-template-columns: 1.15fr 1fr; align-items: center; gap: var(--space-12); }
  }
  .media {
    display: block;
    text-decoration: none;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface);
    aspect-ratio: 1440 / 615;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .feature:hover .media { transform: translate(-3px, -3px); box-shadow: 6px 6px 0 var(--accent); }
  .figures {
    height: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-8);
    color: var(--text);
  }
  .figure { display: grid; gap: 0.15rem; }
  .value { font-family: var(--font-display); font-weight: 700; font-size: clamp(2rem, 1.2rem + 3vw, 3.6rem); line-height: 1; letter-spacing: -0.04em; }
  .what { font-family: var(--font-mono); font-size: var(--fs-xs); color: var(--text-muted); line-height: 1.3; }
  /* Sin portada ni cifras: emblema tipográfico con las iniciales del proyecto y marcas de registro. */
  .emblem {
    position: relative;
    height: 100%;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: var(--space-2);
    padding: var(--space-6) var(--space-8);
    color: var(--text);
  }
  .initials { font-family: var(--font-display); font-weight: 700; font-size: clamp(3rem, 1.5rem + 6vw, 6rem); line-height: 0.9; letter-spacing: -0.05em; }
  .initials::first-letter { color: var(--accent); }
  .mark { position: absolute; width: 0.8rem; height: 0.8rem; border: 0 solid var(--text); }
  .mark.tl { top: 0.8rem; left: 0.8rem; border-top-width: 1.5px; border-left-width: 1.5px; }
  .mark.tr { top: 0.8rem; right: 0.8rem; border-top-width: 1.5px; border-right-width: 1.5px; }
  .mark.bl { bottom: 0.8rem; left: 0.8rem; border-bottom-width: 1.5px; border-left-width: 1.5px; }
  .mark.br { bottom: 0.8rem; right: 0.8rem; border-bottom-width: 1.5px; border-right-width: 1.5px; }
  .idx { color: var(--accent); margin-right: 0.6rem; }
  .title { font-size: var(--fs-xl); margin: 0 0 var(--space-3); }
  .tall .title { font-size: clamp(1.35rem, 1.1rem + 0.9vw, 1.7rem); }
  .title a { color: var(--text); text-decoration: none; }
  .title a:hover { color: var(--accent); }
  .summary { color: var(--text-muted); margin-bottom: var(--space-4); }
  .rol { font-size: var(--fs-sm); margin-bottom: var(--space-4); padding-left: var(--space-4); border-left: 2px solid var(--accent); }
  .rol .label { display: block; margin-bottom: 0.15rem; }
  .links { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); margin: var(--space-4) 0 0; }
  .ext { color: var(--text); }
  .ext:hover { color: var(--accent); }
  .ext::after { content: '↗'; }
</style>
